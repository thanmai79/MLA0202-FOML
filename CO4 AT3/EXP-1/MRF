import matplotlib.pyplot as plt
import networkx as nx
from pgmpy.models import DiscreteMarkovNetwork
from pgmpy.factors.discrete import DiscreteFactor
print("="*60)
print("MARKOV RANDOM FIELD - HEALTHCARE DIAGNOSIS")
print("="*60)
print("Name   : Thanmai Reddy")
print("Reg No : 192425372")
print("="*60)
model=DiscreteMarkovNetwork([("Disease","Fever"),("Disease","Cough"),("Disease","Fatigue"),("Fever","Cough"),("Cough","Fatigue"),("Fatigue","MedicalHistory")])
factor1=DiscreteFactor(["Disease","Fever"],[2,2],[0.8,0.2,0.3,0.7])
factor2=DiscreteFactor(["Disease","Cough"],[2,2],[0.9,0.1,0.4,0.6])
factor3=DiscreteFactor(["Disease","Fatigue"],[2,2],[0.85,0.15,0.4,0.6])
factor4=DiscreteFactor(["Fever","Cough"],[2,2],[0.9,0.1,0.2,0.8])
factor5=DiscreteFactor(["Cough","Fatigue"],[2,2],[0.9,0.1,0.3,0.7])
factor6=DiscreteFactor(["Fatigue","MedicalHistory"],[2,2],[0.8,0.2,0.3,0.7])
model.add_factors(factor1,factor2,factor3,factor4,factor5,factor6)
print("Model Type        : Markov Random Field")
print("Graph Type        : Undirected Graph")
print("Number of Nodes   :",len(model.nodes()))
print("Number of Edges   :",len(model.edges()))
print("Number of Factors :",len(model.get_factors()))
print("Model Valid       :",model.check_model())
print()
print("Patient Symptoms")
print("Fever   : Present")
print("Cough   : Present")
print("Fatigue : Present")
print()
print("Inference Method : Factor-based inference")
print("Result           : Disease risk can be estimated")
print("="*60)
graph=nx.Graph()
graph.add_edges_from([("Disease","Fever"),("Disease","Cough"),("Disease","Fatigue"),("Fever","Cough"),("Cough","Fatigue"),("Fatigue","MedicalHistory")])
pos={"Disease":(0,1),"Fever":(-1,0),"Cough":(0,0),"Fatigue":(1,0),"MedicalHistory":(1,-1)}
plt.figure(figsize=(9,6))
nx.draw(graph,pos,with_labels=True,node_size=3500,node_color="lightgreen",font_size=10,font_weight="bold")
plt.title("Markov Random Field for Disease Diagnosis")
plt.axis("off")
plt.show()

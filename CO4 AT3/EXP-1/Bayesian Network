import matplotlib.pyplot as plt
import networkx as nx
from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination
print("="*60)
print("BAYESIAN NETWORK - HEALTHCARE DIAGNOSIS")
print("="*60)
print("Name   : Thanmai Reddy")
print("Reg No : 192425372")
print("="*60)
model=DiscreteBayesianNetwork([("Disease","Fever"),("Disease","Cough"),("Disease","Fatigue"),("Disease","MedicalHistory")])
cpd_disease=TabularCPD("Disease",2,[[0.70],[0.30]])
cpd_fever=TabularCPD("Fever",2,[[0.80,0.20],[0.20,0.80]],evidence=["Disease"],evidence_card=[2])
cpd_cough=TabularCPD("Cough",2,[[0.90,0.30],[0.10,0.70]],evidence=["Disease"],evidence_card=[2])
cpd_fatigue=TabularCPD("Fatigue",2,[[0.85,0.40],[0.15,0.60]],evidence=["Disease"],evidence_card=[2])
cpd_history=TabularCPD("MedicalHistory",2,[[0.80,0.30],[0.20,0.70]],evidence=["Disease"],evidence_card=[2])
model.add_cpds(cpd_disease,cpd_fever,cpd_cough,cpd_fatigue,cpd_history)
print("Model Valid:",model.check_model())
print()
print("Patient Symptoms")
print("Fever   : Present")
print("Cough   : Present")
print("Fatigue : Present")
print()
inference=VariableElimination(model)
result=inference.query(["Disease"],evidence={"Fever":1,"Cough":1,"Fatigue":1})
print("Disease Probability")
print(result)
print()
print("Diagnosis Result")
print("Disease Probability : %.2f%%"%(result.values[1]*100))
print("Diagnosis           : Disease Likely")
print("="*60)
graph=nx.DiGraph()
graph.add_edges_from([("Disease","Fever"),("Disease","Cough"),("Disease","Fatigue"),("Disease","MedicalHistory")])
pos={"Disease":(0,1),"Fever":(-1,0),"Cough":(0,0),"Fatigue":(1,0),"MedicalHistory":(0,-1)}
plt.figure(figsize=(9,6))
nx.draw(graph,pos,with_labels=True,node_size=3500,node_color="lightblue",font_size=10,font_weight="bold",arrows=True)
plt.title("Bayesian Network for Disease Diagnosis")
plt.axis("off")
plt.show()

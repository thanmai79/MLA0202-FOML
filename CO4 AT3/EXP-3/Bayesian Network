import matplotlib.pyplot as plt
import networkx as nx
from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination
print("="*60)
print("BAYESIAN NETWORK - FINANCIAL RISK PREDICTION")
print("="*60)
print("Name   : Thanmai Reddy")
print("Reg No : 192425372")
print("="*60)
model=DiscreteBayesianNetwork([("Income","CreditScore"),("Debt","CreditScore"),("CreditScore","DefaultRisk"),("TransactionRisk","DefaultRisk")])
cpd_income=TabularCPD("Income",2,[[0.60],[0.40]])
cpd_debt=TabularCPD("Debt",2,[[0.70],[0.30]])
cpd_transaction=TabularCPD("TransactionRisk",2,[[0.80],[0.20]])
cpd_credit=TabularCPD("CreditScore",2,[[0.80,0.40,0.50,0.20],[0.20,0.60,0.50,0.80]],evidence=["Income","Debt"],evidence_card=[2,2])
cpd_default=TabularCPD("DefaultRisk",2,[[0.90,0.60,0.70,0.20],[0.10,0.40,0.30,0.80]],evidence=["CreditScore","TransactionRisk"],evidence_card=[2,2])
model.add_cpds(cpd_income,cpd_debt,cpd_transaction,cpd_credit,cpd_default)
print("Model Valid:",model.check_model())
print()
print("Customer Information")
print("Income Level     : High")
print("Debt Level       : High")
print("Transaction Risk : High")
print()
inference=VariableElimination(model)
result=inference.query(["DefaultRisk"],evidence={"Income":1,"Debt":1,"TransactionRisk":1})
print("Default Risk Probability")
print(result)
print()
print("Risk Prediction Result")
print("-"*40)
print("Default Risk       : %.2f%%"%(result.values[1]*100))
print("Risk Classification: HIGH RISK")
print("Recommended Action : Detailed Financial Review")
print("="*60)
graph=nx.DiGraph()
graph.add_edges_from([("Income","CreditScore"),("Debt","CreditScore"),("CreditScore","DefaultRisk"),("TransactionRisk","DefaultRisk")])
pos={"Income":(-1,1),"Debt":(-1,0),"CreditScore":(0,0.5),"TransactionRisk":(1,0),"DefaultRisk":(2,0.5)}
plt.figure(figsize=(10,6))
nx.draw(graph,pos,with_labels=True,node_size=3500,node_color="lightblue",font_size=10,font_weight="bold",arrows=True)
plt.title("Bayesian Network for Financial Risk Prediction")
plt.axis("off")
plt.show()

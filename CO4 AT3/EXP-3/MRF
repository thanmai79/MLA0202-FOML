import matplotlib.pyplot as plt
import networkx as nx
from pgmpy.models import DiscreteMarkovNetwork
from pgmpy.factors.discrete import DiscreteFactor
print("="*60)
print("MARKOV RANDOM FIELD - FINANCIAL RISK PREDICTION")
print("="*60)
print("Name   : Thanmai Reddy")
print("Reg No : 192425372")
print("="*60)
model=DiscreteMarkovNetwork([("Income","CreditScore"),("Debt","CreditScore"),("CreditScore","DefaultRisk"),("TransactionRisk","DefaultRisk"),("Debt","DefaultRisk")])
factor1=DiscreteFactor(["Income","CreditScore"],[2,2],[0.8,0.2,0.3,0.7])
factor2=DiscreteFactor(["Debt","CreditScore"],[2,2],[0.7,0.3,0.4,0.6])
factor3=DiscreteFactor(["CreditScore","DefaultRisk"],[2,2],[0.9,0.1,0.4,0.6])
factor4=DiscreteFactor(["TransactionRisk","DefaultRisk"],[2,2],[0.9,0.1,0.3,0.7])
factor5=DiscreteFactor(["Debt","DefaultRisk"],[2,2],[0.85,0.15,0.3,0.7])
model.add_factors(factor1,factor2,factor3,factor4,factor5)
print("Model Type        : Markov Random Field")
print("Graph Type        : Undirected Graph")
print("Number of Nodes   :",len(model.nodes()))
print("Number of Edges   :",len(model.edges()))
print("Number of Factors :",len(model.get_factors()))
print("Model Valid       :",model.check_model())
print()
print("Customer Information")
print("Income Level     : High")
print("Debt Level       : High")
print("Transaction Risk : High")
print()
print("Inference Method : Factor-based inference")
print("Result           : Financial risk relationships modeled")
print("="*60)
graph=nx.Graph()
graph.add_edges_from([("Income","CreditScore"),("Debt","CreditScore"),("CreditScore","DefaultRisk"),("TransactionRisk","DefaultRisk"),("Debt","DefaultRisk")])
pos={"Income":(-1,1),"Debt":(-1,0),"CreditScore":(0,1),"TransactionRisk":(1,0),"DefaultRisk":(1,1)}
plt.figure(figsize=(10,6))
nx.draw(graph,pos,with_labels=True,node_size=3500,node_color="lightgreen",font_size=10,font_weight="bold")
plt.title("Markov Random Field for Financial Risk Prediction")
plt.axis("off")
plt.show()

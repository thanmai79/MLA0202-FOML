import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA,FactorAnalysis,FastICA
name="THANMAI REDDY"
reg_no="192425372"
df=pd.read_csv("Wine_Dataset.csv")
X=StandardScaler().fit_transform(df.drop("target",axis=1))
y=df["target"]
p=PCA(n_components=2)
P=p.fit_transform(X)
F=FactorAnalysis(n_components=2,random_state=42).fit_transform(X)
I=FastICA(n_components=2,random_state=42,max_iter=1000).fit_transform(X)
print("="*55)
print("DIMENSIONALITY REDUCTION USING PCA, FA AND ICA")
print("="*55)
print("Name:",name)
print("Register Number:",reg_no)
print("Dataset: Wine")
print("Samples:",len(df))
print("Original Features:",X.shape[1])
print("Reduced Features: 2")
print("\nPCA RESULTS")
print("PC1 Variance:",round(p.explained_variance_ratio_[0]*100,2),"%")
print("PC2 Variance:",round(p.explained_variance_ratio_[1]*100,2),"%")
print("Total Variance:",round(sum(p.explained_variance_ratio_)*100,2),"%")
print("\nDIMENSIONALITY REDUCTION")
print("PCA: 13 to 2")
print("Factor Analysis: 13 to 2")
print("ICA: 13 to 2")
print("\nCurse of Dimensionality is reduced by using fewer features.")
print("="*55)
plt.figure(figsize=(15,4))
plt.subplot(1,3,1)
plt.scatter(P[:,0],P[:,1],c=y,cmap="viridis",s=40)
plt.xlabel("PC1")
plt.ylabel("PC2")
plt.title("PCA")
plt.subplot(1,3,2)
plt.scatter(F[:,0],F[:,1],c=y,cmap="viridis",s=40)
plt.xlabel("Factor 1")
plt.ylabel("Factor 2")
plt.title("Factor Analysis")
plt.subplot(1,3,3)
plt.scatter(I[:,0],I[:,1],c=y,cmap="viridis",s=40)
plt.xlabel("IC1")
plt.ylabel("IC2")
plt.title("ICA")
plt.tight_layout()
plt.show()

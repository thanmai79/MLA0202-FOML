import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score

name="THANMAI REDDY"
reg_no="192425372"

df=pd.read_csv("Mall_Customers.csv")
X=StandardScaler().fit_transform(df[['Age','Annual Income (k$)','Spending Score (1-100)']])
scores=[]; inertia=[]

for k in range(2,11):
    m=KMeans(n_clusters=k,random_state=42,n_init=10)
    l=m.fit_predict(X)
    inertia.append(m.inertia_)
    scores.append(silhouette_score(X,l))

best_k=range(2,11)[scores.index(max(scores))]

print("="*55)
print("CUSTOMER SEGMENTATION USING K-MEANS AND PCA")
print("="*55)
print("Name:",name)
print("Register Number:",reg_no)
print("Dataset: Mall Customers")
print("Customers:",len(df))
print("Best Number of Clusters:",best_k)
print("Best Silhouette Score:",round(max(scores),4))
print("="*55)

plt.figure(figsize=(10,4))
plt.subplot(1,2,1)
plt.plot(range(2,11),inertia,'o-')
plt.xlabel("Number of Clusters")
plt.ylabel("Inertia")
plt.title("Elbow Method")
plt.grid()
plt.subplot(1,2,2)
plt.plot(range(2,11),scores,'o-')
plt.xlabel("Number of Clusters")
plt.ylabel("Silhouette Score")
plt.title("Silhouette Score")
plt.grid()
plt.tight_layout()
plt.show()

labels=KMeans(n_clusters=best_k,random_state=42,n_init=10).fit_predict(X)
p=PCA(n_components=2)
Z=p.fit_transform(X)

print("PCA Variance:",round(sum(p.explained_variance_ratio_)*100,2),"%")
print("\nCustomers in Each Cluster:")
for i in range(best_k):
    print("Cluster",i,":",sum(labels==i),"customers")

plt.figure(figsize=(7,5))
plt.scatter(Z[:,0],Z[:,1],c=labels,cmap='viridis',s=50)
plt.xlabel("PC1")
plt.ylabel("PC2")
plt.title("K-Means Clusters using PCA")
plt.colorbar(label="Cluster")
plt.show()
